# ---------------------------------------------------------------
# AI Avatar Studio - environment configuration
# Copy this file to ".env" and fill in your own values.
# NEVER commit the real ".env" file to git.
# ---------------------------------------------------------------

# --- Application ------------------------------------------------
APP_NAME=AI Avatar Studio
DEBUG=true

# MOCK_MODE=true  -> no GPU is used, generation is simulated.
# MOCK_MODE=false -> real RunPod + CosyVoice + SoulX-Flash pipeline.
MOCK_MODE=true

# How long (seconds) a simulated generation should take in mock mode.
MOCK_DURATION_SECONDS=12

# --- Storage backend -------------------------------------------
# auto     -> use Supabase if SUPABASE_URL and SUPABASE_KEY are set, otherwise local disk
# supabase -> always use Supabase (fails loudly if not configured)
# local    -> always use the local disk fallback (./storage) + local JSON database
STORAGE_BACKEND=auto

# --- Supabase ---------------------------------------------------
SUPABASE_URL=your_supabase_url
SUPABASE_KEY=your_supabase_anon_key

# Server-side only key. Needed to write to Storage / bypass RLS from the backend.
# This key must NEVER be sent to the browser.
SUPABASE_SERVICE_KEY=your_supabase_service_role_key

SUPABASE_BUCKET=avatar-files

# --- Authentication --------------------------------------------
# Phase 1 can run without auth. When false, every generation is saved
# under DEV_USER_ID so the history page still works.
AUTH_ENABLED=false
DEV_USER_ID=00000000-0000-0000-0000-000000000001

# --- RunPod Serverless -----------------------------------------
RUNPOD_API_KEY=your_runpod_api_key
RUNPOD_BASE_URL=https://api.runpod.ai/v2

COSYVOICE_ENDPOINT_ID=your_cosyvoice_endpoint_id
SOULXFLASH_ENDPOINT_ID=your_soulxflash_endpoint_id

# Polling behaviour for RunPod jobs
RUNPOD_POLL_INTERVAL=3
RUNPOD_TIMEOUT_SECONDS=1800

# --- Limits / validation ---------------------------------------
MAX_IMAGE_MB=10
MAX_VOICE_MB=25
MAX_SCRIPT_CHARS=5000
MIN_DURATION_SECONDS=5
MAX_DURATION_SECONDS=300
ALLOWED_QUALITIES=480p,720p,1080p
WORDS_PER_MINUTE=150

# --- CORS -------------------------------------------------------
# Comma separated list, or * for everything (development only).
CORS_ORIGINS=*
